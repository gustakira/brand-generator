{
  "name": "brand-generator",
  "version": "0.1.0",
  "description": "Converta marcas em PNG e SVG para vers\u00f5es 1024, favicons e assets web.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "brand-generator": "dist/cli.js"
  },
  "exports": {
    "types": "./dist/converter.d.ts",
    "import": "./dist/converter.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "convert": "tsx src/cli.ts convert",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "types": "./dist/converter.d.ts"
}
